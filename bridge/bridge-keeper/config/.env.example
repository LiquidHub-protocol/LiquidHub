# =============================================================================
# Liquid Hub - Bridge Keeper configuration
# =============================================================================
# Copy this file to config/.env and fill in your own values.
# Never commit config/.env.

# Keeper wallet (0x + 64 hex characters). It only needs native gas; bridge
# destinations, amounts and bounty eligibility remain enforced on-chain.
PRIVATE_KEY=0x

# Shared signer state. Keep the same value in every pool/bridge keeper process
# that deliberately uses the same key on the same chain.
KEEPER_STATE_DIR=~/.liquidhub-keeper-state

# Maximum accepted legacy gasPrice and EIP-1559 maxFeePerGas / priority fee,
# in gwei. The keeper refuses to sign above this local economic safety cap.
KEEPER_MAX_GAS_PRICE_GWEI=10

# Maximum Stargate fee accepted by the keeper, valued from the live native/USD
# oracle below. Use 0 only to disable this off-chain economic cap deliberately.
MAX_STARGATE_FEE_USD=5

# Same-chain distribution pays no bounty. Opt in only if you accept its gas cost.
ENABLE_UNPAID_SAME_CHAIN_DISTRIBUTION=false
NATIVE_ORACLE_MAX_AGE_SEC=7200

# Persistent local incident log after N consecutive failed cycles. Recovery is also logged.
# Public/community keepers never access protocol Telegram or AWS secrets.
ALERT_AFTER_CYCLES=3

# Polling interval for the long-running keeper.
CHECK_INTERVAL_MIN=15

# Official live native-token/USD Chainlink feeds for each configured chain.
# The address can alternatively be supplied as "nativeOracle" in each Treasury entry.
NATIVE_USD_ORACLE_42161=0x639Fe6ab55C921f74e7fac1ee960C0B6293ba612
# NATIVE_USD_ORACLE_8453=0x0000000000000000000000000000000000000000
# NATIVE_USD_ORACLE_10=0x0000000000000000000000000000000000000000
# NATIVE_USD_ORACLE_1=0x0000000000000000000000000000000000000000
# NATIVE_USD_ORACLE_137=0x0000000000000000000000000000000000000000
# NATIVE_USD_ORACLE_43114=0x0000000000000000000000000000000000000000
# NATIVE_USD_ORACLE_56=0x0000000000000000000000000000000000000000

# JSON array of Treasuries. Every entry must provide:
# - exact Treasury contract and chain-specific USDC addresses (validated against Treasury.usdc() on-chain);
# - chainId;
# - at least three distinct RPC endpoints, tried sequentially for reads and the same signed tx.
# Non-USDC token conversion is governance-only and must not be configured here.
TREASURIES=[{"name":"LP Treasury","address":"0x1111111111111111111111111111111111111111","usdc":"0x2222222222222222222222222222222222222222","chainId":42161,"rpcUrls":["https://rpc.example-1.invalid","https://rpc.example-2.invalid","https://rpc.example-3.invalid"]}]
