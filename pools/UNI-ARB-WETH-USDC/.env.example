# =============================================================================
# Liquid Hub — Standard Pool Keeper (UNI-ARB-WETH-USDC)
# =============================================================================
# Copy this file to .env and fill in your values.
# This is a community keeper configuration — you only need the variables
# required to run a keeper bot that calls public rebalance() on the protocol.

# --- RPC Endpoints (Arbitrum) ---
# Required network identity. Every configured RPC is authenticated against this chain before use.
CHAINID=42161
# Primary RPC (required). Backups are optional but recommended for resilience.
RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_BACKUP_1=
RPC_BACKUP_2=

# --- Contract Addresses ---
# Find the official deployed addresses on the protocol's Contracts page:
#   https://liquidhub.app/docs#contracts-addresses
# (Do not guess or hardcode addresses — always copy them from that page.)
RANGEMANAGER_ADDRESS=
RANGE_STRATEGY_ENGINE_ADDRESS=
VAULT_ADDRESS=
STRATEGY_PROFILE=EXPOSED
# Required only for deposit processing: if blank or temporarily unreadable, the keeper skips
# deposits fail-closed. Strategy checkpoints and eligible rebalances remain available.
PAUSE_CONTROLLER_ADDRESS=
# Treasury address (find it on the protocol's Contracts page). Optional but recommended:
# lets the keeper read the Treasury USDC balance and warn you when a bounty would be skipped
# because the Treasury is underfunded. If left blank, it is discovered via vault.treasuryAddress().
TREASURY_ADDRESS=

# --- Token Addresses (Arbitrum, already filled for WETH/USDC) ---
TOKEN0_ADDRESS=0x82af49447d8a07e3bd95bd0d56f35241523fbab1
TOKEN1_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
TOKEN0_DECIMALS=18
TOKEN1_DECIMALS=6

# --- Keeper Wallet ---
# Private key of the keeper wallet (funded with ETH for gas).
# Keepers earn USDC bounties from the Treasury (paid to whoever sends the tx):
#   - rebalance()           -> keeper bounty
#   - processDepositPermissionless() -> deposit bounty
#   - checkpointMarketState() -> strategy checkpoint bounty (once per due epoch)
# Bounties are only paid when enabled AND the Treasury holds enough USDC; otherwise the action
# still succeeds but no bounty is paid. Verify the Treasury balance on-chain before relying on it.
KEEPER_PRIVATE_KEY=
# Local ceiling applied before signing and to same-nonce replacement transactions.
# A shared signer journal created by the DN keeper for exact HF_REPAIR/repairHealthFactor() retains its exemption;
# locally-created standard-pool actions never bypass this ceiling.
# 10 gwei is deliberately generous for Arbitrum while rejecting abusive RPC fee suggestions.
KEEPER_MAX_GAS_PRICE_GWEI=10

# --- Shared signer state ---
# Keep this exact value in every pool/bridge keeper using the same key and chain.
KEEPER_STATE_DIR=~/.liquidhub-keeper-state

# --- Persistent local incident state ---
# Logs after 3 consecutive failed deposit/mint/checkpoint cycles and once on recovery.
# Public/community keepers never access protocol Telegram or AWS secrets; only the protocol bot does.
POOL_NAME=UNI-ARB-WETH-USDC

# --- Keeper Timing ---
# How often the keeper polls the canonical strategy decision (in minutes).
# One minute preserves the keeper priority window before the protocol bot takes over.
# Must be a finite number greater than zero; invalid values stop startup immediately.
CHECK_INTERVAL_MIN=1
# Local retry heuristic only. Before retrying a stale action plan, refresh prices and rebuild it.
# The contracts' on-chain oracle/TWAP/cache checks remain authoritative.
KEEPER_PRICE_CACHE_MAX_AGE_SEC=300
